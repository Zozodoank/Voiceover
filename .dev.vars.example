# .dev.vars.example - Salin jadi ".dev.vars" untuk pengembangan lokal (npx wrangler dev)
# File ini TIDAK pernah di-commit / diunduh (dirasakan .gitignore).
GEMINI_API_KEY=ISI_GEMINI_API_KEY_DISINI
AIVENE_API_KEY=ISI_AIVENE_API_KEY_DISINI
SESSION_SECRET=ganti-dengan-string-acak-panjang-untuk-hmac-sesi
MACRODROID_SECRET_KEY=ISI_SECRET_MACRODROID_DISINI
# Payload QRIS STATIS merchant (string hasil scan QRIS, diawali 000201010211... dan diakhiri 6304XXXX).
# Opsional - lebih baik diatur dari dasbor admin (tersimpan di KV, bisa divalidasi + pratinjau).
# QRIS_STATIC_PAYLOAD=00020101021126...6304ABCD
# Untuk produksi gunakan: npx wrangler secret put <NAMA>
